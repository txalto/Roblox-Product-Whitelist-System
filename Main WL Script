local Players = game:GetService("Players")

local GROUP_ID = 12345678 -- your group ID
local MIN_RANK = 0 -- set a minimum rank if needed (0 = any group member)

local function handleUnauthorized(player)
	warn(player.Name .. " is not authorized to use this product.")

	local product = workspace:FindFirstChild("YourProduct") -- rename as needed
	if product then
		product:Destroy()
	end

	player:Kick("Unauthorized access. Join the group to use this product.")
end

Players.PlayerAdded:Connect(function(player)
	if not player:IsInGroup(GROUP_ID) or player:GetRankInGroup(GROUP_ID) < MIN_RANK then
		handleUnauthorized(player)
	end
end)
